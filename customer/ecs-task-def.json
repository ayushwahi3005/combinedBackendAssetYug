{
  "family": "assetyug-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "1024",
  "memory": "3072",
  "executionRoleArn": "arn:aws:iam::122610523600:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "assetyug-container",
      "image": "122610523600.dkr.ecr.us-east-1.amazonaws.com/assetyug-repository:latest",
      "cpu": 0,
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp",
          "appProtocol": "http",
          "name": "assetyug-8080"
        }
      ],
      "environment": [
        { "name": "MONGO_URI", "value": "${MONGO_URI}" },
        { "name": "MAIL_USERNAME", "value": "${MAIL_USERNAME}" },
        { "name": "MAIL_PASSWORD", "value": "${MAIL_PASSWORD}" },
        { "name": "STRIPE_SECRET_KEY", "value": "${STRIPE_SECRET_KEY}" },
        { "name": "STRIPE_WEBHOOK_ENDPOINT", "value": "${STRIPE_WEBHOOK_ENDPOINT}" },
        { "name": "JWT_SECRET_KEY", "value": "${JWT_SECRET_KEY}" },
        { "name": "FIREBASE_SERVICE_ACCOUNT", "value": "${FIREBASE_SERVICE_ACCOUNT}" },
        { "name": "FIREBASE_PROJECT_ID", "value": "${FIREBASE_PROJECT_ID}" },
        { "name": "FIREBASE_PRIVATE_KEY_ID", "value": "${FIREBASE_PRIVATE_KEY_ID}" },
        { "name": "FIREBASE_PRIVATE_KEY", "value": "${FIREBASE_PRIVATE_KEY}" },
        { "name": "FIREBASE_CLIENT_EMAIL", "value": "${FIREBASE_CLIENT_EMAIL}" },
        { "name": "FIREBASE_CLIENT_ID", "value": "${FIREBASE_CLIENT_ID}" },
        { "name": "FIREBASE_CLIENT_X509_CERT_URL", "value": "${FIREBASE_CLIENT_X509_CERT_URL}" }
      ],
      "mountPoints": [],
      "volumesFrom": [],
      "systemControls": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/assetyug-task",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true",
          "mode": "non-blocking",
          "max-buffer-size": "25m"
        }
      }
    }
  ],
  "volumes": [],
  "placementConstraints": [],
  "tags": []
}
