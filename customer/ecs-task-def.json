{
  "family": "assetyug-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "1024",
  "memory": "3072",
  "executionRoleArn": "arn:aws:iam::122610523600:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "assetyug-container",
      "image": "122610523600.dkr.ecr.us-east-1.amazonaws.com/assetyug-repository:latest",
      "cpu": 0,
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp",
          "appProtocol": "http",
          "name": "assetyug-8080"
        }
      ],
      "environment": [],
      "mountPoints": [],
      "volumesFrom": [],
      "systemControls": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/assetyug-task",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true",
          "mode": "non-blocking",
          "max-buffer-size": "25m"
        }
      }
    }
  ],
  "volumes": [],
  "placementConstraints": [],
  "tags": []
}
